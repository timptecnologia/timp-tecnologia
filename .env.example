# TIMP Tecnologia — variáveis de ambiente.
# Copie para .env.local (NUNCA versionado) e preencha. Valores abaixo são vazios/fictícios.
# Validação central: lib/env/schema.ts

# --- Públicas (vão para o bundle do browser; só informação pública) ---
# development | test | preview | production  (controla robots/noindex e regras de produção)
NEXT_PUBLIC_APP_ENV=development
# URL canônica do site (https obrigatório em produção)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Project Settings → API. Definir as duas juntas.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NUNCA coloque a secret/service_role aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Servidor (NUNCA prefixar com NEXT_PUBLIC_) ---
# Secret key (sb_secret_...). Somente server-side, somente lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
# debug | info | warn | error
LOG_LEVEL=info
